# Evaluation-only tests of the NixOS module: rendered output of the typed
# layers, how layer-1 settings combine with them, and the unit's triggers.
{ pkgs, self }:
let
  inherit (pkgs) lib;
  inherit (import ./eval-lib.nix { inherit pkgs self; })
    evalConfig
    rendered
    placeholder
    ;

  header = "; Generated by NixOS (services.asterisk-declarative); changes will be overwritten.\n\n";

  phone =
    { config, ... }:
    {
      services.asterisk-declarative = {
        enable = true;
        pjsip = {
          transports.udp.port = 5060;
          endpoints."101" = {
            context = "internal";
            callerId = ''"Kitchen" <101>'';
            auth.password = config.lib.asterisk.secret "/run/agenix/101";
          };
        };
        dialplan.contexts.internal.extensions."_1XX" = [ "Dial(PJSIP/\${EXTEN},30)" ];
      };
    };

  unitOf = modules: (evalConfig modules).systemd.services.asterisk;
in
lib.runTests {
  testTypedEndpointSections = {
    expr = (rendered [ phone ])."pjsip.conf";
    expected = header + ''
      [udp]
      type = transport
      bind = 0.0.0.0:5060
      protocol = udp

      [101]
      type = aor
      max_contacts = 1
      qualify_frequency = 60
      remove_existing = yes

      [101]
      type = auth
      password = ${placeholder "/run/agenix/101"}
      username = 101

      [101]
      type = endpoint
      disallow = all
      allow = g722
      allow = ulaw
      allow = alaw
      aors = 101
      auth = 101
      callerid = "Kitchen" <101>
      context = internal
      direct_media = no
    '';
  };

  testTypedTrunkSections = {
    expr =
      (rendered [
        (
          { config, ... }:
          {
            services.asterisk-declarative = {
              enable = true;
              pjsip.trunks.provider = {
                host = "sip.provider.example";
                port = 5070;
                username = "5551000";
                password = config.lib.asterisk.secret "/run/agenix/trunk";
                context = "from-provider";
                allow = [ "ulaw" ];
                registration.contactUser = "5551000";
                identify.match = [ "203.0.113.0/24" ];
              };
              dialplan.contexts.from-provider.extensions."5551000" = [ "Answer()" ];
            };
          }
        )
      ])."pjsip.conf";
    expected = header + ''
      [provider]
      type = aor
      contact = sip:sip.provider.example:5070
      max_contacts = 0
      qualify_frequency = 60
      remove_existing = no

      [provider]
      type = endpoint
      disallow = all
      allow = ulaw
      aors = provider
      context = from-provider
      direct_media = no
      from_domain = sip.provider.example
      from_user = 5551000
      outbound_auth = provider-outbound

      [provider]
      type = identify
      endpoint = provider
      match = 203.0.113.0/24
      match = sip.provider.example

      [provider-outbound]
      type = auth
      password = ${placeholder "/run/agenix/trunk"}
      username = 5551000

      [provider]
      type = registration
      client_uri = sip:5551000@sip.provider.example:5070
      contact_user = 5551000
      endpoint = provider
      expiration = 3600
      line = yes
      outbound_auth = provider-outbound
      retry_interval = 60
      server_uri = sip:sip.provider.example:5070
    '';
  };

  testTypedDialplan = {
    expr =
      (rendered [
        (
          { config, ... }:
          let
            dp = config.lib.asterisk.dialplan;
          in
          {
            services.asterisk-declarative = {
              enable = true;
              dialplan = {
                globals.OPERATOR = "101";
                contexts = {
                  internal = {
                    includes = [ "paging" ];
                    hints."101" = "PJSIP/101";
                    extensions = {
                      "101" = [
                        "Dial(PJSIP/101,20)"
                        {
                          app = "VoiceMail";
                          args = [
                            "101@default"
                            "u"
                          ];
                          label = "vm";
                        }
                        "Hangup()"
                      ];
                      "_1XX" = [ "Dial(PJSIP/${dp.var "EXTEN"})" ];
                    };
                  };
                  paging.extensions."100" = [
                    (dp.page {
                      endpoints = [
                        "101"
                        "102"
                      ];
                      predial = "autoanswer";
                    })
                  ];
                  autoanswer = dp.autoAnswerContext { };
                  legacy.extraConfig = "exten => 999,1,Playback(tt-monkeys)";
                };
              };
            };
          }
        )
      ])."extensions.conf";
    expected = header + ''
      [general]
      clearglobalvars = yes
      static = yes
      writeprotect = yes

      [globals]
      OPERATOR = 101

      [autoanswer]
      exten => s,1,Set(PJSIP_HEADER(add,Call-Info)=<sip:intercom>\;answer-after=0)
       same => n,Set(PJSIP_HEADER(add,Alert-Info)=info=alert-autoanswer)
       same => n,Return()

      [internal]
      include => paging
      exten => 101,hint,PJSIP/101
      exten => 101,1,Dial(PJSIP/101,20)
       same => n(vm),VoiceMail(101@default,u)
       same => n,Hangup()
      exten => _1XX,1,Dial(PJSIP/''${EXTEN})

      [legacy]

      [paging]
      exten => 100,1,Page(PJSIP/101&PJSIP/102,db(autoanswer^s^1),20)

      [legacy]
      exten => 999,1,Playback(tt-monkeys)
    '';
  };

  testLayerOneOverridesTypedScalarsAndExtendsLists = {
    expr =
      let
        files = rendered [
          phone
          {
            services.asterisk-declarative.settings."pjsip.conf"."endpoint:101" = {
              context = "internal";
              callerid = ''"Hall" <101>'';
              # list order across modules is controlled with mkBefore/mkAfter
              allow = lib.mkAfter [ "opus" ];
              dtmf_mode = "info";
            };
          }
        ];
      in
      builtins.filter (line: builtins.match "(callerid|allow|dtmf_mode) = .*" line != null) (
        lib.splitString "\n" files."pjsip.conf"
      );
    expected = [
      "allow = g722"
      "allow = ulaw"
      "allow = alaw"
      "allow = opus"
      ''callerid = "Hall" <101>''
      "dtmf_mode = info"
    ];
  };

  testTypedSettingsOptionReachesSection = {
    expr =
      lib.hasInfix "rtp_timeout = 30"
        (rendered [
          phone
          { services.asterisk-declarative.pjsip.endpoints."101".settings.rtp_timeout = 30; }
        ])."pjsip.conf";
    expected = true;
  };

  testFirewallPerInterface = {
    expr =
      let
        config = evalConfig [
          phone
          {
            services.asterisk-declarative = {
              openFirewall = true;
              firewallInterfaces = [ "voip" ];
              pjsip.transports.tls = {
                protocol = "tls";
                tls.certFile = "/var/lib/acme/pbx/cert.pem";
                tls.keyFile = "/var/lib/acme/pbx/key.pem";
              };
              rtp.portRange = {
                from = 16384;
                to = 16483;
              };
            };
          }
        ];
      in
      {
        voip = config.networking.firewall.interfaces.voip;
        global = {
          inherit (config.networking.firewall) allowedUDPPorts allowedTCPPorts allowedUDPPortRanges;
        };
      };
    expected = {
      voip = {
        allowedTCPPorts = [ 5061 ];
        allowedTCPPortRanges = [ ];
        allowedUDPPorts = [ 5060 ];
        allowedUDPPortRanges = [
          {
            from = 16384;
            to = 16483;
          }
        ];
      };
      global = {
        allowedUDPPorts = [ ];
        allowedTCPPorts = [ ];
        allowedUDPPortRanges = [ ];
      };
    };
  };

  testTlsFilesAreCredentials = {
    expr =
      let
        config = evalConfig [
          phone
          {
            services.asterisk-declarative.pjsip.transports.tls = {
              protocol = "tls";
              tls.certFile = "/var/lib/acme/pbx/cert.pem";
              tls.keyFile = "/var/lib/acme/pbx/key.pem";
            };
          }
        ];
      in
      {
        inherit (config.systemd.services.asterisk.serviceConfig) LoadCredential;
        key = builtins.filter (lib.hasPrefix "priv_key_file") (
          lib.splitString "\n" config.services.asterisk-declarative.renderedFiles."pjsip.conf"
        );
      };
    expected = {
      LoadCredential = [
        "${self.lib.secrets.credentialName (self.lib.secret "/run/agenix/101")}:/run/agenix/101"
        "pjsip-tls-cert:/var/lib/acme/pbx/cert.pem"
        "pjsip-tls-key:/var/lib/acme/pbx/key.pem"
      ];
      key = [ "priv_key_file = /run/credentials/asterisk.service/pjsip-tls-key" ];
    };
  };

  testInterpolatedAndRawSecretsAreLoaded = {
    expr =
      let
        config = evalConfig [
          phone
          (
            { config, ... }:
            {
              services.asterisk-declarative = {
                settings."voicemail.conf".default."200" =
                  "${config.lib.asterisk.secret "/run/agenix/vm-200"},Sales,sales@example.org";
                extraConfig."manager.conf" = ''
                  [admin]
                  secret = @NIX_ASTERISK_SECRET:file:/run/agenix/ami@
                '';
              };
            }
          )
        ];
        loaded = config.systemd.services.asterisk.serviceConfig.LoadCredential;
        credential = path: "${self.lib.secrets.credentialName (self.lib.secret path)}:${path}";
      in
      map (path: builtins.elem (credential path) loaded) [
        "/run/agenix/101"
        "/run/agenix/vm-200"
        "/run/agenix/ami"
      ];
    expected = [
      true
      true
      true
    ];
  };

  testLowPortsGetCapability = {
    expr =
      map
        (
          port:
          (unitOf [
            phone
            { services.asterisk-declarative.pjsip.transports.udp.port = lib.mkForce port; }
          ]).serviceConfig.CapabilityBoundingSet
        )
        [
          5060
          443
        ];
    expected = [
      [ "" ]
      [ "CAP_NET_BIND_SERVICE" ]
    ];
  };

  # Only the reload trigger changes when the dialplan changes...
  testDialplanChangeOnlyReloads = {
    expr =
      let
        a = unitOf [ phone ];
        b = unitOf [
          phone
          { services.asterisk-declarative.dialplan.contexts.internal.extensions."200" = [ "Answer()" ]; }
        ];
      in
      {
        sameStart = a.serviceConfig.ExecStart == b.serviceConfig.ExecStart;
        sameStartPre = a.serviceConfig.ExecStartPre == b.serviceConfig.ExecStartPre;
        sameRestart = a.restartTriggers == b.restartTriggers;
        sameReload = a.reloadTriggers == b.reloadTriggers;
      };
    expected = {
      sameStart = true;
      sameStartPre = true;
      sameRestart = true;
      sameReload = false;
    };
  };

  # ...while transports and modules.conf restart the service.
  testTransportAndModuleChangesRestart = {
    expr =
      let
        base = unitOf [ phone ];
        transport = unitOf [
          phone
          { services.asterisk-declarative.pjsip.transports.udp.port = lib.mkForce 5070; }
        ];
        modules = unitOf [
          phone
          { services.asterisk-declarative.modules.load = [ "app_system.so" ]; }
        ];
      in
      [
        (base.restartTriggers == transport.restartTriggers)
        (base.restartTriggers == modules.restartTriggers)
      ];
    expected = [
      false
      false
    ];
  };

  testReloadOnChangeDisabledRestarts = {
    expr =
      let
        unit = unitOf [
          phone
          { services.asterisk-declarative.reloadOnChange = false; }
        ];
      in
      [
        (unit.reloadTriggers == [ ])
        (builtins.length unit.restartTriggers)
      ];
    expected = [
      true
      2
    ];
  };

  # --- tier 2 -------------------------------------------------------------

  testVoicemailMailboxLines = {
    expr =
      let
        files = rendered [
          phone
          (
            { config, ... }:
            {
              services.asterisk-declarative.voicemail.mailboxes = {
                "101" = {
                  pin = config.lib.asterisk.secret "/run/agenix/vm-101";
                  fullName = "Alice";
                  email = "alice@example.org";
                  options.attach = true;
                };
                "200@sales".pin = config.lib.asterisk.secret "/run/agenix/vm-200";
              };
            }
          )
        ];
      in
      builtins.filter (line: builtins.match "(\\[.*|[0-9]+ => .*)" line != null) (
        lib.splitString "\n" files."voicemail.conf"
      );
    expected = [
      "[general]"
      "[default]"
      "101 => ${placeholder "/run/agenix/vm-101"},Alice,alice@example.org,,attach=yes"
      "[sales]"
      "200 => ${placeholder "/run/agenix/vm-200"},200"
    ];
  };

  testConfbridgeProfiles = {
    expr =
      (rendered [
        phone
        (
          { config, ... }:
          {
            services.asterisk-declarative.confbridge = {
              bridges.board.maxMembers = 10;
              users.chair = {
                admin = true;
                marked = true;
                pin = config.lib.asterisk.secret "/run/agenix/conference";
              };
              menus.admin_menu = {
                "*1" = "toggle_mute";
                "*2" = "admin_kick_last";
              };
            };
          }
        )
      ])."confbridge.conf";
    expected = header + ''
      [general]

      [board]
      type = bridge
      max_members = 10

      [admin_menu]
      type = menu
      *1 = toggle_mute
      *2 = admin_kick_last

      [chair]
      type = user
      admin = yes
      marked = yes
      pin = ${placeholder "/run/agenix/conference"}
    '';
  };

  testQueueMembers = {
    expr = builtins.filter (lib.hasPrefix "member") (
      lib.splitString "\n"
        (rendered [
          phone
          {
            services.asterisk-declarative.queues.queues.support.members = [
              "PJSIP/101"
              {
                interface = "PJSIP/102";
                penalty = 2;
                name = "Bob";
              }
              {
                interface = "Local/103@internal";
                stateInterface = "PJSIP/103";
              }
            ];
          }
        ])."queues.conf"
    );
    expected = [
      "member => PJSIP/101"
      "member => PJSIP/102,2,Bob"
      "member => Local/103@internal,,,PJSIP/103"
    ];
  };

  testFeatureMapAndApplications = {
    expr =
      (rendered [
        phone
        {
          services.asterisk-declarative.features = {
            featureMap = {
              blindxfer = "#1";
              automixmon = "*3";
            };
            applications.monkeys = {
              dtmf = "*9";
              activateOn = "peer";
              app = "Playback";
              args = "tt-monkeys";
            };
          };
        }
      ])."features.conf";
    expected = header + ''
      [general]

      [applicationmap]
      monkeys => *9,peer,Playback,tt-monkeys

      [featuremap]
      automixmon = *3
      blindxfer = #1
    '';
  };

  testAmiUserSection = {
    expr =
      (rendered [
        phone
        (
          { config, ... }:
          {
            services.asterisk-declarative.ami = {
              enable = true;
              users.monitor.secret = config.lib.asterisk.secret "/run/agenix/ami";
            };
          }
        )
      ])."manager.conf";
    expected = header + ''
      [general]
      bindaddr = 127.0.0.1
      enabled = yes
      port = 5038

      [monitor]
      deny = 0.0.0.0/0.0.0.0
      deny = ::/0
      permit = 127.0.0.1/255.255.255.255
      permit = ::1/128
      read = all
      secret = ${placeholder "/run/agenix/ami"}
    '';
  };

  testAriLoadsModulesAndHttpTlsCredentials = {
    expr =
      let
        config = evalConfig [
          phone
          (
            { config, ... }:
            {
              services.asterisk-declarative = {
                http = {
                  enable = true;
                  tls = {
                    enable = true;
                    certFile = "/var/lib/acme/pbx/cert.pem";
                    keyFile = "/var/lib/acme/pbx/key.pem";
                  };
                };
                ari = {
                  enable = true;
                  users.app.password = config.lib.asterisk.secret "/run/agenix/ari";
                };
              };
            }
          )
        ];
        files = config.services.asterisk-declarative.renderedFiles;
      in
      {
        modules = map (m: lib.hasInfix "load => ${m}" files."modules.conf") [
          "res_ari.so"
          "res_ari_channels.so"
          "app_stasis.so"
          "res_http_websocket.so"
          # a dependency of res_ari.so since Asterisk 22.5
          "res_websocket_client.so"
        ];
        tls =
          lib.hasInfix "tlsprivatekey = /run/credentials/asterisk.service/http-tls-key"
            files."http.conf";
        credentials = builtins.filter (lib.hasPrefix "http-tls") config.systemd.services.asterisk.serviceConfig.LoadCredential;
        # res_websocket_client logs an error without its file
        websocketClientConf = files ? "websocket_client.conf";
      };
    expected = {
      modules = [
        true
        true
        true
        true
        true
      ];
      tls = true;
      credentials = [
        "http-tls-cert:/var/lib/acme/pbx/cert.pem"
        "http-tls-key:/var/lib/acme/pbx/key.pem"
      ];
      websocketClientConf = true;
    };
  };

  testWebsocketTransportLoadsModules = {
    expr =
      lib.hasInfix "load => res_pjsip_transport_websocket.so"
        (rendered [
          phone
          {
            services.asterisk-declarative = {
              http.enable = true;
              pjsip.transports.ws.protocol = "ws";
            };
          }
        ])."modules.conf";
    expected = true;
  };

  # cdr_csv declines to load when [csv] has no keys
  testCdrCsvSectionIsNeverEmpty = {
    expr =
      lib.hasInfix "[csv]\naccountlogs = yes\nloguniqueid = no\n"
        (rendered [
          phone
          { services.asterisk-declarative.cdr.csv.enable = true; }
        ])."cdr.conf";
    expected = true;
  };

  testCdrSqliteUsesArrows = {
    expr = builtins.head (
      builtins.filter (lib.hasPrefix "table") (
        lib.splitString "\n"
          (rendered [
            phone
            { services.asterisk-declarative.cdr.sqlite.enable = true; }
          ])."cdr_sqlite3_custom.conf"
      )
    );
    expected = "table => cdr";
  };

  testMusicOnHoldDirectoryFromStore = {
    expr =
      lib.hasInfix "directory = ${builtins.storeDir}/"
        (rendered [
          phone
          (
            { pkgs, ... }:
            {
              services.asterisk-declarative.musicOnHold.classes.office.directory = pkgs.linkFarm "moh" [ ];
            }
          )
        ])."musiconhold.conf";
    expected = true;
  };

  testTypedMusicOnHoldOverridesBuiltinDefault = {
    expr =
      lib.hasInfix "directory = custom"
        (rendered [
          phone
          { services.asterisk-declarative.musicOnHold.classes.default.directory = "custom"; }
        ])."musiconhold.conf";
    expected = true;
  };

  # the dialplan example in README.md renders as shown there
  testReadmeDialplanExample = {
    expr =
      let
        text =
          (rendered [
            { services.asterisk-declarative.enable = true; }
            (
              { config, ... }:
              let
                dp = config.lib.asterisk.dialplan;
              in
              {
                services.asterisk-declarative.dialplan = {
                  globals.TRUNK = "PJSIP/provider";
                  contexts = {
                    internal = {
                      includes = [ "outbound" ];
                      hints."101" = "PJSIP/101";
                      extensions = {
                        "101" = [
                          "Dial(PJSIP/101,20)"
                          {
                            app = "VoiceMail";
                            args = [
                              "101@default"
                              "u"
                            ];
                            label = "vm";
                          }
                          "Hangup()"
                        ];
                        "100" = [
                          (dp.page {
                            endpoints = [
                              "101"
                              "102"
                            ];
                            predial = "autoanswer";
                          })
                        ];
                      };
                    };
                    autoanswer = dp.autoAnswerContext { };
                    outbound.extensions."_9X." = [ "Dial(\${TRUNK}/\${EXTEN:1})" ];
                  };
                };
              }
            )
          ])."extensions.conf";
      in
      lib.findFirst (lib.hasPrefix "[internal]") null (lib.splitString "\n\n" text);
    expected = ''
      [internal]
      include => outbound
      exten => 100,1,Page(PJSIP/101&PJSIP/102,db(autoanswer^s^1),20)
      exten => 101,hint,PJSIP/101
      exten => 101,1,Dial(PJSIP/101,20)
       same => n(vm),VoiceMail(101@default,u)
       same => n,Hangup()'';
  };

  # Asterisk ignores -p unless it starts as root: systemd sets the policy
  testRealtimeSchedulingIsSetBySystemd = {
    expr =
      let
        service =
          (evalConfig [
            phone
            { services.asterisk-declarative.realtime = true; }
          ]).systemd.services.asterisk.serviceConfig;
      in
      {
        inherit (service)
          CPUSchedulingPolicy
          CPUSchedulingPriority
          LimitRTPRIO
          RestrictRealtime
          ;
        dashP = lib.hasInfix " -p" service.ExecStart;
      };
    expected = {
      CPUSchedulingPolicy = "rr";
      CPUSchedulingPriority = 10;
      LimitRTPRIO = 10;
      RestrictRealtime = false;
      dashP = false;
    };
  };

  # static addresses of interfaces other than the default gateway's may come
  # up after network-online.target; a transport bound to one must wait
  testWaitsForSpecificBindAddresses = {
    expr =
      map
        (
          bind:
          builtins.length
            (unitOf [
              phone
              { services.asterisk-declarative.pjsip.transports.udp.address = lib.mkIf (bind != null) bind; }
            ]).serviceConfig.ExecStartPre
        )
        [
          null
          "127.0.0.1"
          "10.0.20.10"
        ];
    expected = [
      1
      1
      2
    ];
  };

  testChanSipAlwaysNoloaded = {
    expr = lib.hasInfix "noload => chan_sip.so" (rendered [ phone ])."modules.conf";
    expected = true;
  };

  testLibIsAvailableWithoutEnable = {
    expr = "${(evalConfig [ ]).lib.asterisk.secret "/run/x"}";
    expected = "@NIX_ASTERISK_SECRET:file:/run/x@";
  };
}
